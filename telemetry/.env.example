# Telemetry service (Person 6) — environment variables introduced by this
# component. Copy these keys into the root .env (which is git-crypt encrypted)
# and set real values there. NOTHING in this file is a real secret.
#
#     cp .env.example ../.env   # then edit the root .env
#
# The root .env is the single source of truth (CONTRIBUTING.md §3); Compose
# loads it automatically for `docker compose up --build`.

# --- required ---------------------------------------------------------------

# Auditing has its own tables in the shared instance: audit_events and spans.
# Telemetry never reads another service's tables (docs/database.md §2).
DATABASE_URL=postgres://telemetry:changeme@db.example.com:5432/postgres

# Authenticates collectors pushing into the audit pipeline. Without it anyone
# who can reach the port could forge or flood the security record.
# Generate one with: openssl rand -hex 32
TELEMETRY_INGEST_TOKEN=replace-with-openssl-rand-hex-32

# --- optional ---------------------------------------------------------------

# Read API and dashboard. Leave empty for an open local dashboard; set it and
# open http://localhost:8088/dashboard?token=<value> to authenticate.
TELEMETRY_READ_TOKEN=

# Where the service listens (inside the container).
TELEMETRY_ADDR=:8088

# postgres (default) or memory. Memory is volatile and only for a quick demo.
TELEMETRY_STORE=postgres

# How long the audit trail is kept, and how often retention is enforced.
TELEMETRY_RETENTION=720h
TELEMETRY_RETENTION_INTERVAL=1h

# Max ingest payload accepted from one collector call.
TELEMETRY_MAX_BODY_BYTES=4194304

# The window the dashboard opens with.
TELEMETRY_DASHBOARD_WINDOW=24h

# Mirror received spans to another OTLP collector (Jaeger's visual span
# browser). Empty disables mirroring; the audit copy is written either way.
TELEMETRY_FORWARD_OTLP_ENDPOINT=http://jaeger:4318

TELEMETRY_LOG_LEVEL=info

# --- TLS / mTLS (the project's Transport Contract, docs/division.md §2) -------
#
# Leave all of these unset for plain HTTP, which is what the rest of the stack
# does today. They are here so the audit channel can join the shared CA by
# configuration rather than by a code change once Person 2 lands it.
#
# The ingest API serves TLS 1.3 and verifies peers against TELEMETRY_TLS_CA_FILE.
# With TELEMETRY_TLS_REQUIRE_CLIENT_CERT=true a collector without a CA-issued
# certificate is refused during the handshake; false verifies a certificate that
# is offered and lets an anonymous peer through, which is the staged rollout.
TELEMETRY_TLS_CERT_FILE=
TELEMETRY_TLS_KEY_FILE=
TELEMETRY_TLS_CA_FILE=
TELEMETRY_TLS_REQUIRE_CLIENT_CERT=false

# --- shipper (audit log consumer) -------------------------------------------

DOCKER_SOCKET=/var/run/docker.sock
# https:// once the ingest API is serving TLS, otherwise the collector refuses
# to start rather than exchange a certificate over a cleartext connection.
TELEMETRY_URL=http://telemetry:8088
# The collector verifies the API with TELEMETRY_TLS_CA_FILE (above) and presents
# its own certificate with TELEMETRY_TLS_CERT_FILE / _KEY_FILE. TELEMETRY_TLS_SERVER_NAME
# overrides the name verified in the API's certificate (default: the host in TELEMETRY_URL).
TELEMETRY_TLS_SERVER_NAME=

# Which containers to follow. Default: every container carrying this label.
TELEMETRY_SHIP_LABEL=com.docker.compose.project
# Value to match. Empty means "whichever project the shipper itself runs in".
TELEMETRY_SHIP_PROJECT=
# Or an explicit allowlist that replaces label discovery.
TELEMETRY_SHIP_CONTAINERS=
# Stripped from container names so the audit trail says "idp", not
# "dss-project-idp-1". Empty defaults to "<project>-".
TELEMETRY_SHIP_SERVICE_PREFIX=

TELEMETRY_SHIP_FLUSH_INTERVAL=2s
TELEMETRY_SHIP_MAX_BATCH=200
TELEMETRY_SHIP_QUEUE=20000
TELEMETRY_SHIP_DISCOVER_INTERVAL=15s
# How far back a dropped log stream re-reads. Duplicates are discarded by the
# ingest API's idempotency check, so overlap is safe and loss is not.
TELEMETRY_SHIP_OVERLAP_SECONDS=10

# The shipper's own health, readiness and metrics listener, and the host port it
# is published on. Leave this unset to keep the default: an empty value here
# falls back to :8089, so disabling the listener means removing it (and the port
# mapping) from the service definition in docker-compose.yml.
TELEMETRY_SHIP_ADDR=:8089
TELEMETRY_SHIP_PORT=8089
# How much history the shipper reads from a container the first time it follows
# it. Restarting must not re-read a week-old log file; "0s" reads everything.
TELEMETRY_SHIP_BACKFILL=30m

# The gid of the host's docker socket, so the shipper can read it as a non-root
# user. Find it with:  stat -c '%g' /var/run/docker.sock
TELEMETRY_DOCKER_GID=960

# --- observability backends -------------------------------------------------

JAEGER_UI_PORT=16686
LOKI_PORT=3100
# 3300 rather than Grafana's usual 3000, which is often already taken locally.
GRAFANA_PORT=3300
