# Unlock the encrypted .env for the configured deployment.
# For your own local stack, supply an RSA PEM with literal \n escapes.
DATABASE_URL=postgres://postgres:change-me@localhost:5432/postgres?sslmode=require
IDP_RSA_PRIVATE_KEY=replace-with-a-complete-RSA-private-key
TELEMETRY_INGEST_TOKEN=replace-with-a-random-32-byte-token
TELEMETRY_READ_TOKEN=
TELEMETRY_DOCKER_GID=956
GATEWAY_PORT=8080
GATEWAY_RATE_LIMIT=120
GATEWAY_RATE_WINDOW=60
DSS_IPV6_ENABLED=true
