# Payment & Transaction Service (Person 5) — environment variables.
#
# Copy these keys into the root .env (which is git-crypt encrypted) and set the
# real values there. NOTHING in this file is a real secret.
#
#     cp .env.example ../.env     # then edit the root .env
#
# The root .env is the single source of truth (CONTRIBUTING.md §3); Compose loads
# it automatically for `docker compose up --build`.

# --- required ---------------------------------------------------------------

# The ledger. This service owns the `transactions` table in the shared instance
# and reads no other service's tables (docs/database.md §2). Its migration
# bookkeeping is namespaced (`payment_schema_migrations`), because the default
# `schema_migrations` table is per-database and five services migrate the same
# instance.
DATABASE_URL=postgres://payment:changeme@db.example.com:5432/postgres

# --- transport: mTLS (the project's Transport Contract, docs/division.md §2) --
#
# The listener serves TLS 1.3 and requires a client certificate that chains to
# PAYMENT_TLS_CA_FILE. All three are required unless
# PAYMENT_ALLOW_INSECURE_HTTP=true, which exists only for a throwaway demo.
#
# Generate a local development CA and the certificates for it with:
#     docker compose run --rm --user 0:0 payment-service-certs
#   or, with a local Go toolchain:
#     cd payment-service && go run ./cmd/server certs --dir ./certs
#
# The certificate identifies `payment-service` (the Compose service name), which
# is also the name every peer has to dial.
PAYMENT_TLS_CERT_FILE=/certs/payment-service.crt
PAYMENT_TLS_KEY_FILE=/certs/payment-service.key
# The shared CA that signed the callers' certificates.
PAYMENT_TLS_CA_FILE=/certs/ca.crt
# Strict mTLS is the default. Set false only for a staged rollout: an offered
# certificate is still verified, an absent one is tolerated (and the API refuses
# it later). The service logs a warning on every start.
PAYMENT_TLS_REQUIRE_CLIENT_CERT=true

# Serving without TLS at all. LOCAL DEMOS ONLY: the service logs a warning and
# never reports mTLS as verified, so every TRANSFER is denied by the policy
# engine's mTLS requirement.
PAYMENT_ALLOW_INSECURE_HTTP=false

# Which client identities may call the business API. A certificate that chains to
# the shared CA proves the caller is inside the trust domain; this list decides
# who is allowed to move money. The `probe` certificate (used by the health
# check) is deliberately absent: diagnostics may ask whether the service is
# alive, and may not call /transfer.
PAYMENT_ALLOWED_CLIENT_IDS=gateway,account-service

# --- service ----------------------------------------------------------------

PAYMENT_ADDR=:8081
PAYMENT_SERVICE_NAME=payment-service
# postgres (durable, default) or memory (volatile, local demos only).
PAYMENT_STORE=postgres
PAYMENT_DB_MAX_CONNS=6
PAYMENT_MAX_BODY_BYTES=65536
PAYMENT_LOG_LEVEL=info
PAYMENT_SHUTDOWN_GRACE=15s

# --- identity: the IdP's tokens (Person 1) -----------------------------------

# This service verifies the bearer token again, against the IdP's public keys.
# The gateway having checked it (docs/flow.md §2) is not a reason for the callee
# to trust it: that is the assumption Zero-Trust exists to remove.
PAYMENT_JWKS_URL=http://idp:8080/.well-known/jwks.json
PAYMENT_JWKS_CACHE_TTL=5m
# How often an unknown `kid` may force a key-set refetch, so a flood of junk
# kids cannot become a flood of requests to the IdP.
PAYMENT_JWKS_UNKNOWN_KID_INTERVAL=10s
PAYMENT_JWKS_TIMEOUT=5s
# Expected claims. Empty PAYMENT_JWT_ISSUER skips the issuer check.
PAYMENT_JWT_ISSUER=
PAYMENT_JWT_AUDIENCE=zerotrust-api-gateway
PAYMENT_JWT_CLOCK_SKEW=30s
# TLS for the JWKS endpoint, if the IdP is ever reached over https.
PAYMENT_JWKS_TLS_CERT_FILE=
PAYMENT_JWKS_TLS_KEY_FILE=
PAYMENT_JWKS_TLS_CA_FILE=
PAYMENT_JWKS_TLS_SERVER_NAME=

# --- authorization: the Policy Engine (Person 3) -----------------------------
#
# docs/policymaker.md specifies this endpoint as http://, so plain HTTP here is
# the contract rather than a lapse. It supports https the moment Person 3 adds a
# TLS listener — set the URL to https and fill in PAYMENT_POLICY_TLS_*.
PAYMENT_POLICY_URL=http://policy-engine:8181/v1/data/authz/allow
PAYMENT_POLICY_TIMEOUT=2s
PAYMENT_POLICY_TLS_CERT_FILE=
PAYMENT_POLICY_TLS_KEY_FILE=
PAYMENT_POLICY_TLS_CA_FILE=
PAYMENT_POLICY_TLS_SERVER_NAME=

# --- business: the Account Service (Person 4) --------------------------------
#
# The only component that owns the balances. This service calls
# /api/v1/accounts/deduct and never touches the accounts table.
#
# https by default: internal service-to-service traffic must satisfy the
# Transport Contract. PAYMENT_ALLOW_INSECURE_UPSTREAM=true is required to point
# this at http://, and the service warns on every start when it is set.
PAYMENT_ACCOUNT_SERVICE_URL=https://account-service:8082
PAYMENT_ACCOUNT_TIMEOUT=5s
PAYMENT_ALLOW_INSECURE_UPSTREAM=false
# This service's *client* identity for that call (the shared CA signed it).
PAYMENT_UPSTREAM_TLS_CERT_FILE=/certs/payment-service-client.crt
PAYMENT_UPSTREAM_TLS_KEY_FILE=/certs/payment-service-client.key
PAYMENT_UPSTREAM_TLS_CA_FILE=/certs/ca.crt
PAYMENT_UPSTREAM_TLS_SERVER_NAME=

# --- business rules ---------------------------------------------------------

# The largest amount this service will even ask the policy engine about. The
# default is the range of the DECIMAL(10,2) column, NOT the business threshold:
# "a transfer above 50 000 is fraud" is a policy decision and lives in Person 3's
# Rego, where it can be changed without redeploying this service.
PAYMENT_MAX_TRANSFER_AMOUNT=99999999.99
# Require a customer's `sub` claim to match the request's sender_id. Without it
# any authenticated customer could debit any account by naming it.
PAYMENT_ENFORCE_SENDER_BINDING=true

# --- observability (Person 6) ------------------------------------------------

# The audit decisions go to stdout, where the audit collector picks them up with
# no configuration on either side (telemetry/docs/integration.md §1). This is
# only for spans: set it to telemetry's OTLP endpoint so this service appears in
# the trace view, and give it the same token the collector uses.
PAYMENT_OTLP_ENDPOINT=http://telemetry:8088/v1/traces
PAYMENT_OTLP_TOKEN=replace-with-the-TELEMETRY_INGEST_TOKEN
PAYMENT_OTLP_TIMEOUT=5s
PAYMENT_OTLP_TLS_CERT_FILE=
PAYMENT_OTLP_TLS_KEY_FILE=
PAYMENT_OTLP_TLS_CA_FILE=
PAYMENT_OTLP_TLS_SERVER_NAME=

# --- consumed by Compose, not by the Go code ---------------------------------

# The host port the API is published on. Publishing an internal service on the
# host is a local-development convenience for the verification steps in
# README.md §"Testing"; in a real deployment only the API Gateway (Person 2)
# would be reachable, and it would reach this service over the Compose network.
PAYMENT_PORT=8081

# Where the one-shot `payment-service-certs` service writes the development CA.
PAYMENT_CERTS_DIR=./payment-service/certs
