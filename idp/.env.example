# IdP service environment — dummy DEV-ONLY values (CONTRIBUTING.md §3).
#
# Copy this file to the git-crypt-encrypted .env (or merge these variables
# into the root .env) and replace the values with the real credentials that
# were shared securely with the team. Never commit real secrets.
#
# Required:
#   DATABASE_URL                PostgreSQL connection string (Supabase)
#   IDP_RSA_PRIVATE_KEY         RSA private key, PEM, "\n"-escaped
#                              (or IDP_RSA_PRIVATE_KEY_PATH -> PEM file)
#
# Optional:
#   IDP_PORT                     HTTP listen port (default 8080)
#   IDP_JWT_ISSUER               issuer claim (default http://idp:8080)
#   IDP_JWT_AUDIENCE             audience claim (default zerotrust-api-gateway)
#   IDP_JWT_TTL                  token lifetime (default 15m)
#
# Generate a fresh key with:  idp-server genkey
#
# The key below is a DEV-ONLY placeholder so `docker compose up` works for
# every team member out of the box. It is public knowledge and must never be
# used outside local development.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/zerotrust?sslmode=disable

IDP_RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEpQI.........fy/VEm3SNAZ99OZhrggX2oLWJLyhU\nqgxFLrRcgkUlIR5DEIuuoJFgWkARncTwiLrz9Cq/GFPb+r1bTfg1xBo=\n-----END RSA PRIVATE KEY-----

# Alternative to the inline key (Docker secrets / mounted files):
# IDP_RSA_PRIVATE_KEY_PATH=/run/secrets/idp_rsa_private.pem

IDP_PORT=8080
IDP_JWT_ISSUER=http://idp:8080
IDP_JWT_AUDIENCE=zerotrust-api-gateway
IDP_JWT_TTL=15m
